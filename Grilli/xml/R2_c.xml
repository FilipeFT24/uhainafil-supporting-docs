<config>
  <io>
    <iparam key="mesh_dimension"        val="1"/>
    <sparam key="mesh_file"             val="/gpfs/scratch/fortetenreiro/run/Grilli/msh/Grilli.msh"/>
    <sparam key="mesh_format"           val="ParaGMSH"/>
    <iparam key="prepartitioning"       val="0"/>
    <iparam key="redistribution"        val="1"/>
    <sparam key="output_format"         val="HDF5"/>
    <sparam key="output_path"           val="/gpfs/scratch/fortetenreiro/run/Grilli/visu/R2_c"/>
    <sparam key="restartPath"           val="/gpfs/scratch/fortetenreiro/run/Grilli/restart/R2_c"/>
    <sparam key="postProcPath"          val="/gpfs/scratch/fortetenreiro/run/Grilli/visu/R2_c/data"/>
    <sparam key="restartPrefix"         val="restart"/>
    <iparam key="conservativeVariables" val="2"/>
    <sparam key="visutype"              val="cells"/>
    <iparam key="fprint"                val="150"/>
    <sparam key="ProbePosition"         val="file:/gpfs/scratch/fortetenreiro/run/Grilli/probes.txt"/>
    <iparam key="gprint"                val="3000"/>
    <fparam key="t0_g"                  val="-1"/>
    <iparam key="active"                val="1"/>
    <iparam key="scalab"                val="0"/>
  </io>
  <aerosol>
    <iparam key="debug"                 val="0"/>
    <sparam key="linearsolver"          val="PETSc"/>
  </aerosol>
  <discretisation>
    <iparam key="continuous"            val="0"/>
    <iparam key="degree"                val="3"/>
    <sparam key="femtype"               val="Lagrange"/>
    <sparam key="numericalflux"         val="WbswLaxFriedrichs"/>
  </discretisation>
  <model>
    <sparam key="name"                  val="ShallowWater"/>
    <iparam key="dispersion"            val="2"/>
    <fparam key="dispOptimParam"        val="1"/>
    <fparam key="g"                     val="9.81"/>
    <fparam key="h0"                    val="0.44"/>
    <sparam key="bathymetry"            val="1;0;ICBC"/>
    <sparam key="manning"               val="1;0;ICBC;CONSTANT;0.00"/>
  </model>
  <petsc>
    <sparam key="cmdLineArgs"           val="-log_view -log_view_memory -n 1 -ksp_type preonly -ksp_reuse_preconditioner -pc_type lu -pc_factor_mat_solver_type mumps -pc_factor_reuse_ordering -pc_factor_reuse_fill"/>
  </petsc>
  <testcase>
    <sparam key="name"                  val="GrilliAbbott"/>
    <fparam key="A0"                    val="0.20"/>
  </testcase>
  <time>
    <sparam key="inittype"              val="interpolation"/>
    <sparam key="name"                  val="SSPRK-8-4"/>
    <sparam key="type"                  val="cfl"/>
    <fparam key="CFL"                   val="0.37917"/>
    <fparam key="tmax"                  val="9.4285951943780865747157804435119"/>
  </time>
</config>